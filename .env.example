# GitHub OAuth Configuration
# Copy this file to .env and fill in your actual credentials

# Get these from: https://github.com/settings/developers
# Create a new OAuth App with:
# - Homepage URL: https://github.com/DavinciDreams/duly-noted
# - Callback URL: chrome-extension://[YOUR_EXTENSION_ID]/src/oauth/oauth-callback.html

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Optional: Google OAuth (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion OAuth Configuration
# Get these from: https://www.notion.so/my-integrations
# Create a new public integration with:
# - Integration type: Public
# - Redirect URI: https://[YOUR_EXTENSION_ID].chromiumapp.org/
# - Capabilities: Read content, Update content, Insert content
#
# Note: Find your extension ID at chrome://extensions
# Example: https://mhichihooaoppodidfoipflnlljkjcpa.chromiumapp.org/

NOTION_CLIENT_ID=your_notion_client_id_here
NOTION_CLIENT_SECRET=your_notion_client_secret_here

# Vision Model API Configuration
# These are used for the Front-End Testing Agent to analyze UI components

# Zai (Zhipu AI) API Key
# Get from: https://open.bigmodel.cn/
ZAI_API_KEY=your_zai_api_key_here

# OpenRouter API Key
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Claude Code (Anthropic) API Key
# Get from: https://console.anthropic.com/
# Note: Claude API keys should start with "sk-ant-"
ANTHROPIC_API_KEY=your_anthropic_api_key_here
